{
  "name": "localbrain-web-assets",
  "private": true,
  "version": "0.0.0",
  "description": "Build-only browser assets for LocalBrain",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:mermaid": "node scripts/build-mermaid-assets.mjs build",
    "check:mermaid": "node scripts/build-mermaid-assets.mjs check",
    "test:mermaid": "node scripts/test-mermaid-assets.mjs",
    "test:workflow-map": "node --test tests/workflow-map.test.mjs"
  },
  "dependencies": {
    "@mermaid-js/layout-elk": "0.2.2",
    "mermaid": "11.16.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
