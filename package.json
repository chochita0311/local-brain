{
  "name": "localbrain-web-assets",
  "private": true,
  "version": "0.0.0",
  "description": "Build-only browser assets for LocalBrain",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:terminal": "node scripts/build-terminal-assets.mjs build",
    "check:terminal": "node scripts/build-terminal-assets.mjs check",
    "test:terminal": "node --test tests/terminal-checkpoint.test.cjs tests/terminal-input.test.cjs tests/terminal-pty-input.test.cjs tests/terminal-colors.test.cjs",
    "build:mermaid": "node scripts/build-mermaid-assets.mjs build",
    "check:mermaid": "node scripts/build-mermaid-assets.mjs check",
    "test:mermaid": "node scripts/test-mermaid-assets.mjs",
    "test:workflow-map": "node --test tests/workflow-map.test.mjs"
  },
  "dependencies": {
    "@mermaid-js/layout-elk": "0.2.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "6.0.0",
    "mermaid": "11.16.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
